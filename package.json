{
  "name": "pipefy-api",
  "version": "1.9.1",
  "description": "This library provides a convenient way to interact with the Pipefy API, allowing developers to easily integrate Pipefy functionality into their applications. It includes functions for managing cards, pipes, comments, and more.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.types.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Go-Business-Inc/PipefyAPI.git"
  },
  "keywords": [
    "pipefy",
    "typescript",
    "api",
    "library"
  ],
  "type": "commonjs",
  "author": "Ramón David Sifuentes from Go Business Inc.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "node-fetch": "^3.0.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.69.0"
  },
  "bugs": {
    "url": "https://github.com/Go-Business-Inc/PipefyAPI/issues"
  },
  "homepage": "https://github.com/Go-Business-Inc/PipefyAPI#readme"
}
